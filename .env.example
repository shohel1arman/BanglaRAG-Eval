# BanglaRAG-Eval — environment variable template.
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; NEVER
# commit real keys. Automatic evaluators and RAG backends read credentials
# from the environment only — no key is ever hard-coded in source.
#
# Copy this file to `.env`. All model names and paths used by the campaign
# are configurable here. Keep API keys only in `.env`, never in Git.

# --- Local LLM via Ollama (no paid API needed) ---
OLLAMA_BASE_URL=http://localhost:11434
# One model for the simple pilot runner:
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=bge-m3

# Campaign generators. Comma-separated Ollama tags; changing this changes the
# factorial and target record count. The v3.3 default produces 50,000 records.
BANGLARAG_GENERATOR_MODELS=qwen3:4b,qwen3:8b,gemma3:4b,llama3.2:3b,phi3.5:3.8b,qwen3:32b,qwen3:30b,gemma3:27b,deepseek-r1:32b,qwen2.5:32b
# Optional separate roles used only by the campaign/evaluators.
# They are not required for `scripts/run_pipeline.py --model ...`.
BANGLARAG_TRANSFORM_MODEL=qwen3:8b
BANGLARAG_FALLBACK_TRANSFORM_MODEL=gemma3:4b
BANGLARAG_JUDGE_MODEL=qwen3:8b

# Pull these before running the expanded campaign:
# ollama pull qwen3:8b
# ollama pull qwen3:4b
# ollama pull gemma3:4b
# ollama pull llama3.2:3b
# ollama pull phi3.5:3.8b
# ollama pull qwen3:32b
# ollama pull gemma3:27b
# ollama pull deepseek-r1:32b
# ollama pull qwen3:30b
# ollama pull qwen2.5:32b

# --- Campaign paths and outputs ---
BANGLARAG_CAMPAIGN_CONFIG=configs/campaign_50000_v3_unreviewed.yaml
BANGLARAG_SOURCE_FILE=data/raw/BanglaQuADv1.0-train.json
BANGLARAG_QUESTIONS_FILE=data/intermediate/campaign_10000_v2_questions.jsonl
BANGLARAG_BASE_EXAMPLES=1000
BANGLARAG_RANDOM_SEED=20261013
BANGLARAG_OUTPUT_FILE=data/campaign_50000_v3_unreviewed.jsonl
BANGLARAG_ANNOTATION_FILE=data/human_annotation_v2.jsonl

# --- LLM judge / generator providers (Milestone 2+) ---
# OpenAI-compatible endpoint for LLM-as-judge and/or generation.
# OPENAI_API_KEY=

# Anthropic Claude (independent LLM judge, cross-model to limit self-preference).
# ANTHROPIC_API_KEY=

# Generic OpenAI-compatible base URL + key for self-hosted / local models.
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=local-no-key

# --- Optional remote providers ---
# Groq is a provider, not an Ollama model. Do not put keys in Git.
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# --- RAGAS / ARES dependencies (Milestone 2+) ---
# RAGAS uses the same LLM provider keys above; no separate key is required.
# ARES may require an annotation LLM key (reuses OPENAI_API_KEY by default).

# --- SemFuse RAG backend (Milestone 2+, if integrated) ---
# SEMFUSE_BASE_URL=
# SEMFUSE_API_KEY=

# --- Reproducibility / run config (optional overrides) ---
# Annotation server
# BANGLARAG_ANNOTATION_SECRET=replace-with-a-local-secret
# BANGLARAG_ANNOTATOR_MODE=both
# BANGLARAG_ANNOTATION_PORT=5000

# Pilot config path (optional).
# BANGLARAG_PILOT_CONFIG=configs/pilot_stage1.yaml
